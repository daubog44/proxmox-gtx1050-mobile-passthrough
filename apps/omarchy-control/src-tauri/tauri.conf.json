{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omarchy Control",
  "version": "0.1.0",
  "identifier": "it.daubog44.omarchy-control",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Omarchy Control", "width": 1120, "height": 760, "minWidth": 760, "minHeight": 620 }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../clients": "clients",
      "../../../scripts": "scripts",
      "../../../systemd": "systemd"
    }
  }
}
