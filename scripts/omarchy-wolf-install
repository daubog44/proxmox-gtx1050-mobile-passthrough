#!/usr/bin/env bash
# Installs Wolf (Games on Whales) next to Sunshine on the Omarchy GPU VM.
#
#   omarchy-wolf-install [check|apply|status] [--repo DIR]
#
# Follows Wolf's official NVIDIA "driver volume" quickstart and adapts it to
# this host (see packaging/wolf/docker-compose.yml): Wolf listens on its own
# ports (Sunshine keeps the Moonlight defaults), renders/encodes on the NVIDIA
# render node, shares /tmp/sockets for the live-view tap and /var/run/wolf for
# the broker. After Wolf wrote its default config, the live tap is applied.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
action="${1:-check}"; shift || true
while (($#)); do
  case "$1" in
    --repo) repo_root="$2"; shift 2 ;;
    *) printf 'argomento sconosciuto: %s\n' "$1" >&2; exit 2 ;;
  esac
done

readonly INSTALL_DIR=/etc/omarchy/wolf
readonly GOW_DRIVER_DOCKERFILE='https://raw.githubusercontent.com/games-on-whales/gow/master/images/nvidia-driver/Dockerfile'
# Sunshine owns 47984/47989/47990/48010 tcp and 47998-48000 udp.
readonly WOLF_TCP_PORTS=(49984 49989 50010)
readonly WOLF_UDP_PORTS=(49999 50100 50200)

die() { printf 'Errore: %s\n' "$*" >&2; exit 1; }

# Works from the repository (omarchy-setup) and from the Arch package.
compose_src="$repo_root/packaging/wolf/docker-compose.yml"
[[ -f "$compose_src" ]] || compose_src=/usr/share/omarchy/wolf/docker-compose.yml
cuda_src="$repo_root/packaging/wolf/cuda-context-ownership.c"
live_tap="$repo_root/scripts/omarchy-wolf-live-tap"
[[ -x "$live_tap" ]] || live_tap="$(command -v omarchy-wolf-live-tap || true)"
wolf_ui_coop="$repo_root/scripts/omarchy-wolf-ui-coop"
[[ -x "$wolf_ui_coop" ]] || wolf_ui_coop="$(command -v omarchy-wolf-ui-coop || true)"
note() { printf '==> %s\n' "$*"; }

compose() {
  if docker compose version >/dev/null 2>&1; then docker compose "$@"; else docker-compose "$@"; fi
}

nvidia_card_node() {
  local node
  for node in /sys/class/drm/card*; do
    [[ "$(basename "$(readlink -f "$node/device/driver")")" == nvidia ]] && { echo "/dev/dri/$(basename "$node")"; return; }
  done
  return 1
}

nvidia_render_node() {
  local node
  for node in /sys/class/drm/renderD*; do
    [[ "$(basename "$(readlink -f "$node/device/driver")")" == nvidia ]] && { echo "/dev/dri/$(basename "$node")"; return; }
  done
  return 1
}

preflight() {
  local problems=0 dev port
  command -v docker >/dev/null || { echo '  - docker non installato'; problems=1; }
  docker info >/dev/null 2>&1 || { echo '  - demone docker non raggiungibile (eseguire come root, docker attivo?)'; problems=1; }
  { docker compose version || command -v docker-compose; } >/dev/null 2>&1 || { echo '  - docker compose non disponibile'; problems=1; }
  [[ "$(cat /sys/module/nvidia_drm/parameters/modeset 2>/dev/null)" == Y ]] || { echo '  - nvidia_drm.modeset non attivo (serve nvidia-drm.modeset=1)'; problems=1; }
  [[ -r /sys/module/nvidia/version ]] || { echo '  - modulo nvidia non caricato'; problems=1; }
  nvidia_render_node >/dev/null || { echo '  - render node NVIDIA non trovato in /dev/dri'; problems=1; }
  for dev in /dev/nvidia0 /dev/nvidiactl /dev/nvidia-modeset /dev/nvidia-uvm /dev/nvidia-uvm-tools /dev/uinput /dev/uhid; do
    [[ -e "$dev" ]] || { echo "  - device mancante: $dev (prova: nvidia-modprobe -u -c=0 / modprobe uinput uhid)"; problems=1; }
  done
  for port in "${WOLF_TCP_PORTS[@]}"; do
    ss -Hltn "sport = :$port" | grep -q . && ! docker ps --format '{{.Names}}' 2>/dev/null | grep -qx wolf && { echo "  - porta TCP $port già occupata"; problems=1; }
  done
  return "$problems"
}

build_driver_volume() {
  local nv_version current
  nv_version="$(cat /sys/module/nvidia/version)"
  current="$(docker image inspect gow/nvidia-driver:latest -f '{{index .Config.Labels "omarchy.nv_version"}}' 2>/dev/null || true)"
  if [[ "$current" != "$nv_version" ]]; then
    note "creo l'immagine del driver NVIDIA $nv_version (gow/nvidia-driver)"
    curl -fsSL "$GOW_DRIVER_DOCKERFILE" \
      | docker build -q -t gow/nvidia-driver:latest --label "omarchy.nv_version=$nv_version" \
          -f - --build-arg "NV_VERSION=$nv_version" . >/dev/null
    # A volume from another driver version would mismatch the kernel module.
    docker volume rm nvidia-driver-vol >/dev/null 2>&1 || true
  fi
  docker volume inspect nvidia-driver-vol >/dev/null 2>&1 \
    || docker create --rm --mount source=nvidia-driver-vol,destination=/usr/nvidia gow/nvidia-driver:latest sh >/dev/null
}

# Pascal supports compositor -> CUDA -> NVENC: verified on GTX 1050 / 580.178.04.
# Keep Wolf's zero-copy default; legacy mode requires an explicit override.
wolf_zero_copy() {
  local value
  value="$(printf '%s' "${OMARCHY_WOLF_ZERO_COPY:-TRUE}" | tr '[:lower:]' '[:upper:]')"
  [[ "$value" == TRUE || "$value" == FALSE ]] || die 'OMARCHY_WOLF_ZERO_COPY deve essere TRUE oppure FALSE'
  echo "$value"
}

open_firewall() {
  command -v ufw >/dev/null || return 0
  local port
  for port in "${WOLF_TCP_PORTS[@]}"; do ufw allow "$port/tcp" comment 'Omarchy Wolf (Moonlight)' >/dev/null; done
  for port in "${WOLF_UDP_PORTS[@]}"; do ufw allow "$port/udp" comment 'Omarchy Wolf (Moonlight)' >/dev/null; done
}

case "$action" in
  check)
    if preflight; then note 'prerequisiti Wolf OK'; else die 'prerequisiti Wolf mancanti (vedi sopra)'; fi
    ;;
  apply)
    (( EUID == 0 )) || die 'eseguire come root'
    zero_copy="$(wolf_zero_copy)"
    preflight || die 'prerequisiti Wolf mancanti (vedi sopra)'
    render_node="$(nvidia_render_node)"
    card_node="$(nvidia_card_node)" || die 'nodo card NVIDIA non trovato in /dev/dri'
    install -d -m 0755 "$INSTALL_DIR" "$INSTALL_DIR/gst-plugins" /etc/wolf /tmp/sockets /var/run/wolf
    [[ -f "$compose_src" ]] || die "docker-compose di Wolf non trovato ($compose_src)"
    if [[ -f "$cuda_src" ]]; then
      command -v cc >/dev/null || die 'compilatore C assente: installare gcc per la correzione CUDA di Wolf'
      cc -shared -fPIC -O2 -std=c11 -Wall -Wextra -Werror "$cuda_src" -ldl -o "$INSTALL_DIR/libwolf-cuda-ownership.so.new"
      mv "$INSTALL_DIR/libwolf-cuda-ownership.so.new" "$INSTALL_DIR/libwolf-cuda-ownership.so"
    else
      install -m 0755 /usr/share/omarchy/wolf/libwolf-cuda-ownership.so "$INSTALL_DIR/libwolf-cuda-ownership.so"
    fi
    install -m 0644 "$compose_src" "$INSTALL_DIR/docker-compose.yml"
    cat > "$INSTALL_DIR/.env" <<EOF
WOLF_RENDER_NODE=$render_node
WOLF_CARD_NODE=$card_node
WOLF_HTTP_PORT=49989
WOLF_HTTPS_PORT=49984
WOLF_CONTROL_PORT=49999
WOLF_RTSP_SETUP_PORT=50010
WOLF_VIDEO_PING_PORT=50100
WOLF_AUDIO_PING_PORT=50200
WOLF_USE_ZERO_COPY=$zero_copy
WOLF_LOG_LEVEL=${OMARCHY_WOLF_LOG_LEVEL:-INFO}
EOF
    # /tmp is cleared at boot: recreate the shared sockets dir before Docker.
    printf 'd /tmp/sockets 0755 root root -\nd /var/run/wolf 0755 root root -\n' > /etc/tmpfiles.d/omarchy-wolf.conf
    build_driver_volume
    # Without persistence mode the driver tears the GPU down whenever nothing
    # uses it: every Wolf launch then pays ~8 s of CUDA/EGL init, past
    # Moonlight's first-frame timeout ("No video received from host").
    if command -v nvidia-persistenced >/dev/null; then
      systemctl enable --now nvidia-persistenced.service >/dev/null 2>&1 \
        || note 'nvidia-persistenced non avviato: il primo frame Wolf può superare il timeout di Moonlight'
    fi
    # A "wolf" container started outside this compose (e.g. by hand) would
    # block `up` with a name conflict and may lack the API socket/mounts.
    # Its state lives in /etc/wolf, so replacing the container keeps it.
    if docker inspect wolf >/dev/null 2>&1; then
      managed_dir="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' wolf 2>/dev/null || true)"
      if [[ "$managed_dir" != "$INSTALL_DIR" ]]; then
        note "sostituisco il container wolf non gestito dal compose Omarchy (${managed_dir:-avviato a mano})"
        docker rm -f wolf >/dev/null
      fi
    fi
    # Old example files set invented variables (WOLF_ENABLE_SESSION_SHARING...).
    if [[ -f /etc/omarchy/wolf.env ]] && grep -q 'WOLF_ENABLE_SESSION_SHARING' /etc/omarchy/wolf.env; then
      cp -p /etc/omarchy/wolf.env "/etc/omarchy/wolf.env.omarchy-bak-$(date +%Y%m%d-%H%M%S)"
      [[ -f "$repo_root/config/wolf.env.example" ]] && install -m 0644 "$repo_root/config/wolf.env.example" /etc/omarchy/wolf.env
      sed -i "s|^WOLF_RENDER_NODE=.*|WOLF_RENDER_NODE=$render_node|" /etc/omarchy/wolf.env
    fi
    compose -f "$INSTALL_DIR/docker-compose.yml" --env-file "$INSTALL_DIR/.env" pull -q
    # The compiled library is replaced atomically: recreate to mount its new inode.
    compose -f "$INSTALL_DIR/docker-compose.yml" --env-file "$INSTALL_DIR/.env" up -d --force-recreate
    open_firewall

    note 'attendo che Wolf generi /etc/wolf/cfg/config.toml'
    for _ in $(seq 60); do [[ -f /etc/wolf/cfg/config.toml && -S /var/run/wolf/wolf.sock ]] && break; sleep 1; done
    [[ -f /etc/wolf/cfg/config.toml ]] || die 'Wolf non ha creato la configurazione: docker logs wolf'
    for _ in $(seq 30); do [[ -S /var/run/wolf/wolf.sock ]] && break; sleep 1; done
    if [[ ! -S /var/run/wolf/wolf.sock ]]; then
      docker logs --tail 300 wolf 2>&1 | grep -iE "API server|socket|error|fatal" | tail -15 >&2 || true
      die 'API di Wolf assente (/var/run/wolf/wolf.sock): profili, lobby e pairing non possono funzionare (log sopra)'
    fi

    # Wolf UI whose "Start" creates multi-user lobbies, so the admin can always
    # join (take over) a guest's game. Long first build (Godot/.NET toolchain).
    if [[ -n "$wolf_ui_coop" ]]; then
      "$wolf_ui_coop" build && "$wolf_ui_coop" apply \
        || note 'Wolf UI multi-utente non applicata: la takeover funzionerà solo sulle lobby "Coop"'
    fi
    # Guest containers on an isolated network: Internet only, no LAN/VM.
    net_iso="$repo_root/scripts/omarchy-wolf-network-isolation"
    [[ -x "$net_iso" ]] || net_iso="$(command -v omarchy-wolf-network-isolation || true)"
    unit_src="$repo_root/systemd/omarchy-wolf-network-isolation.service"
    [[ -f "$unit_src" ]] || unit_src=/usr/lib/systemd/system/omarchy-wolf-network-isolation.service
    if [[ -n "$net_iso" && -f "$unit_src" ]]; then
      if [[ "$net_iso" == "$repo_root/"* ]]; then
        install -m 0755 "$net_iso" /usr/local/bin/omarchy-wolf-network-isolation
        install -m 0644 "$unit_src" /etc/systemd/system/omarchy-wolf-network-isolation.service
        systemctl daemon-reload
      fi
      systemctl enable omarchy-wolf-network-isolation.service >/dev/null 2>&1 || true
      systemctl restart omarchy-wolf-network-isolation.service \
        || die 'isolamento di rete degli ospiti fallito: journalctl -u omarchy-wolf-network-isolation'
      note 'rete ospiti isolata attiva (omarchy-guests: solo Internet)'
    else
      note 'omarchy-wolf-network-isolation non trovato: i giochi ospite vedranno la LAN'
    fi
    # Router port forwarding through UPnP, renewed every 30 min (OMARCHY_UPNP=0
    # in /etc/omarchy/upnp.env to keep manual forwarding only).
    upnp_src="$repo_root/scripts/omarchy-upnp-ports"
    if [[ -x "$upnp_src" ]]; then
      install -m 0755 "$upnp_src" /usr/local/bin/omarchy-upnp-ports
      install -m 0644 "$repo_root/systemd/omarchy-upnp-ports.service" "$repo_root/systemd/omarchy-upnp-ports.timer" /etc/systemd/system/
      systemctl daemon-reload
    fi
    if command -v omarchy-upnp-ports >/dev/null; then
      systemctl enable --now omarchy-upnp-ports.timer >/dev/null 2>&1 || true
      omarchy-upnp-ports apply || note 'UPnP non disponibile sul router: inoltra a mano TCP 49984/49989/50010 e UDP 49999/50100/50200'
    fi
    # One Wolf profile (PIN + allowed apps, own save data) per Omarchy user.
    if command -v omarchy-session-broker >/dev/null; then
      omarchy-session-broker wolf-sync-profiles >/dev/null \
        && note 'profili Wolf sincronizzati con gli utenti Omarchy' \
        || note 'sincronizzazione profili Wolf fallita: omarchy-session-broker wolf-sync-profiles'
    fi

    [[ -n "$live_tap" ]] || die 'omarchy-wolf-live-tap non trovato'
    [[ -f "$INSTALL_DIR/gst-plugins/libgstunixfd.so" ]] || "$live_tap" build-unixfd
    WOLF_CONFIG=/etc/wolf/cfg/config.toml "$live_tap" apply --restart
    systemctl try-restart omarchy-session-broker.service || true
    note "Wolf attivo. In Moonlight aggiungi il PC come <ip-vm>:49989 (Sunshine resta su 47989)"
    ;;
  status)
    docker ps --filter name=^wolf$ --format 'wolf: {{.Status}} ({{.Image}})' 2>/dev/null || true
    [[ -S /var/run/wolf/wolf.sock ]] && echo 'API socket: /var/run/wolf/wolf.sock' || echo 'API socket assente'
    if docker inspect wolf >/dev/null 2>&1; then
      echo "compose: $(docker inspect -f '{{index .Config.Labels "com.docker.compose.project.working_dir"}}' wolf)"
      docker inspect -f '{{range .Config.Env}}{{println .}}{{end}}' wolf | grep -E '^(WOLF_SOCKET_PATH|XDG_RUNTIME_DIR|WOLF_RENDER_NODE|WOLF_HTTP_PORT)=' | sed 's/^/env: /'
      docker inspect -f '{{range .Mounts}}{{.Source}} -> {{.Destination}}{{println}}{{end}}' wolf | grep -E 'wolf|sockets' | sed 's/^/mount: /'
      docker logs --tail 400 wolf 2>&1 | grep -iE 'API server' | tail -2 | sed 's/^/log: /'
    fi
    [[ -n "$live_tap" ]] && "$live_tap" status || true
    [[ -n "$wolf_ui_coop" ]] && "$wolf_ui_coop" status || true
    command -v omarchy-wolf-network-isolation >/dev/null && omarchy-wolf-network-isolation status || true
    command -v omarchy-upnp-ports >/dev/null && omarchy-upnp-ports status || true
    ;;
  *) die 'azione: check, apply oppure status' ;;
esac
