#!/usr/bin/env bash
# Forced command for the dedicated Windows microphone key. It exposes exactly
# the expected microphone operations and a read-only health check; it never
# exposes a shell, forwarding or arbitrary SSH command.
set -Eeuo pipefail

case "${SSH_ORIGINAL_COMMAND:-}" in
  voxtype-remote-mic-receive)
    exec "$HOME/.local/bin/voxtype-remote-mic-receive"
    ;;
  voxtype-remote-mic-control-follow)
    exec "$HOME/.local/bin/voxtype-remote-mic-control-follow"
    ;;
  voxtype-remote-mic-status)
    test -x "$HOME/.local/bin/voxtype-remote-mic-rtp-receive"
    test -f "$HOME/.config/systemd/user/voxtype-remote-mic-rtp.service"
    printf '%s\n' ready
    ;;
  *)
    echo 'Comando microfono non autorizzato.' >&2
    exit 126
    ;;
esac
