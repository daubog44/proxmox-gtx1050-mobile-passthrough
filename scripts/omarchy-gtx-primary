#!/usr/bin/env bash
# Run an Omarchy/Hyprland desktop directly on a passed-through NVIDIA GPU.
# This deliberately uses Hyprland's headless output instead of faking a DRM connector.
set -Eeuo pipefail

readonly USER_NAME='daubog44'
readonly USER_HOME="/home/$USER_NAME"
readonly ENV_FILE="$USER_HOME/.config/uwsm/env-hyprland"
readonly SUNSHINE_FILE="$USER_HOME/.config/sunshine/sunshine.conf"
readonly MONITORS_FILE="$USER_HOME/.config/hypr/monitors.lua"
readonly HEADLESS_HELPER="$USER_HOME/.local/bin/omarchy-headless-output"
readonly SUNSHINE_DROPIN="$USER_HOME/.config/systemd/user/app-dev.lizardbyte.app.Sunshine.service.d/25-headless-output.conf"
readonly RESOLUTION_COMMAND="$USER_HOME/.local/bin/omarchy-stream-resolution"
readonly HEALTH_COMMAND="$USER_HOME/.local/bin/omarchy-stream-health"
readonly BASHRC="$USER_HOME/.bashrc"
readonly SUNSHINE_SERVICE='app-dev.lizardbyte.app.Sunshine.service'
readonly BACKUP_DIR='/root/omarchy-gtx-headless-backup'
readonly STALE_EDID='/usr/lib/firmware/edid/omarchy-1920x1200.bin'
readonly DEFAULT_STREAM_MODE='1920x1200@60'

die() { printf 'Errore: %s\n' "$*" >&2; exit 1; }
note() { printf '==> %s\n' "$*"; }
require_root() { (( EUID == 0 )) || die 'eseguire come root'; }

backup_once() {
  local file=$1 target
  [[ -e "$file" ]] || return 0
  mkdir -p "$BACKUP_DIR"
  target="$BACKUP_DIR${file}"
  [[ -e "$target" ]] || { mkdir -p "$(dirname "$target")"; cp -a "$file" "$target"; }
}

# These purpose-named files are written by this script.  On a later idempotent
# run, do not mistake our own first version for user data and back it up as an
# "original": rollback must remove it when no genuine predecessor existed.
backup_if_unmanaged() {
  local file=$1
  [[ -e "$file" ]] || return 0
  case "$file" in
    "$HEADLESS_HELPER") grep -Fq 'Managed by omarchy-gtx-primary' "$file" && return 0 ;;
    "$SUNSHINE_DROPIN") grep -Fxq "ExecStartPre=$HEADLESS_HELPER" "$file" && return 0 ;;
    "$RESOLUTION_COMMAND"|"$HEALTH_COMMAND") grep -Fq 'Managed by omarchy-gtx-primary' "$file" && return 0 ;;
  esac
  backup_once "$file"
}

replace_or_append() {
  local file=$1 expression=$2 value=$3
  if grep -Eq "$expression" "$file"; then
    sed -i -E "s|$expression|$value|" "$file"
  else
    printf '%s\n' "$value" >>"$file"
  fi
}

validate_stream_mode() {
  local mode=$1 width height refresh
  [[ "$mode" =~ ^([0-9]{3,5})x([0-9]{3,5})@([0-9]{2,3})$ ]] || \
    die 'modalita non valida: usare larghezzaxaltezza@Hz, per esempio 1920x1200@60'
  width=$((10#${BASH_REMATCH[1]}))
  height=$((10#${BASH_REMATCH[2]}))
  refresh=$((10#${BASH_REMATCH[3]}))
  (( width >= 640 && width <= 7680 && height >= 480 && height <= 4320 && refresh >= 24 && refresh <= 240 )) || \
    die 'modalita fuori dai limiti di sicurezza (640-7680, 480-4320, 24-240 Hz)'
}

write_monitor_block() {
  local mode=$1
  sed -i '/-- BEGIN sunshine-virtual-display (managed locally)/,/-- END sunshine-virtual-display/d' "$MONITORS_FILE"
  printf '%s\n' \
    '' \
    '-- BEGIN sunshine-virtual-display (managed locally)' \
    '-- GTX-only Wayland output for Sunshine/Moonlight; no VirtIO display ownership.' \
    "hl.monitor({ output = \"omarchy-gtx\", mode = \"$mode\", position = \"0x0\", scale = 1 })" \
    '-- END sunshine-virtual-display' \
    >>"$MONITORS_FILE"
  chown "$USER_NAME:$USER_NAME" "$MONITORS_FILE"
}

managed_stream_mode() {
  sed -n 's/.*output = "omarchy-gtx", mode = "\([0-9][0-9]*x[0-9][0-9]*@[0-9][0-9]*\)".*/\1/p' "$MONITORS_FILE" | tail -n 1
}

user_session_env() {
  local user_id
  user_id="$(id -u "$USER_NAME")"
  runuser -u "$USER_NAME" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_id" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_id/bus" \
    "$@"
}

install_user_commands() {
  install -d -o "$USER_NAME" -g "$USER_NAME" -m 0755 "$(dirname "$RESOLUTION_COMMAND")"
  backup_if_unmanaged "$RESOLUTION_COMMAND"
  backup_if_unmanaged "$HEALTH_COMMAND"

  cat >"$RESOLUTION_COMMAND" <<'EOF'
#!/usr/bin/env bash
# Managed by omarchy-gtx-primary. User-facing resolution helper.
set -Eeuo pipefail
readonly CONTROL='/usr/local/sbin/omarchy-gtx-primary'

usage() {
  cat <<'USAGE'
Uso: omarchy-stream-resolution <larghezzaxaltezza@Hz|status|help>

Esempi:
  omarchy-stream-resolution 1920x1200@60
  omarchy-stream-resolution 1920x1080@60
  omarchy-stream-resolution status

Il cambio aggiorna l'output headless omarchy-gtx e riavvia Sunshine; uno
stream Moonlight attivo termina e va riaperto per negoziare la nuova modalita.
USAGE
}

case "${1:-help}" in
  status) exec sudo "$CONTROL" status-runtime ;;
  help|-h|--help) usage ;;
  *) [[ $# -eq 1 ]] || { usage >&2; exit 2; }; exec sudo "$CONTROL" set-resolution "$1" ;;
esac
EOF

  cat >"$HEALTH_COMMAND" <<'EOF'
#!/usr/bin/env bash
# Managed by omarchy-gtx-primary. Reports encoder/capture fallback evidence.
set -Eeuo pipefail
readonly CONTROL='/usr/local/sbin/omarchy-gtx-primary'

case "${1:-}" in
  ''|status) exec sudo "$CONTROL" stream-health ;;
  watch) exec sudo "$CONTROL" stream-health --watch ;;
  help|-h|--help)
    cat <<'USAGE'
Uso: omarchy-stream-health [status|watch]

Con Moonlight Desktop aperto, `watch` aggiorna una volta al secondo:
- enc > 0: NVENC sta codificando in hardware;
- enc assente: stream inattivo oppure encoder non attivo; non basta da solo
  per dire che esista un fallback;
- libx264 o errori di import/scala nel journal: fallback o errore reale.
USAGE
    ;;
  *) echo "Azione sconosciuta: $1" >&2; exit 2 ;;
esac
EOF
  chmod 0755 "$RESOLUTION_COMMAND" "$HEALTH_COMMAND"
  chown "$USER_NAME:$USER_NAME" "$RESOLUTION_COMMAND" "$HEALTH_COMMAND"

  [[ -e "$BASHRC" ]] || install -o "$USER_NAME" -g "$USER_NAME" -m 0644 /dev/null "$BASHRC"
  sed -i '/# BEGIN omarchy-gtx-primary commands/,/# END omarchy-gtx-primary commands/d' "$BASHRC"
  cat >>"$BASHRC" <<'EOF'

# BEGIN omarchy-gtx-primary commands
# Short functions for interactive Omarchy shells. The executables also work
# without reloading the shell.
omarchy_stream_resolution() { command "$HOME/.local/bin/omarchy-stream-resolution" "$@"; }
omarchy_stream_health() { command "$HOME/.local/bin/omarchy-stream-health" "$@"; }
# END omarchy-gtx-primary commands
EOF
  chown "$USER_NAME:$USER_NAME" "$BASHRC"
}

prepare_headless() {
  require_root
  local selected_mode
  [[ -e "$ENV_FILE" && -e "$SUNSHINE_FILE" && -e "$MONITORS_FILE" ]] || die 'file di configurazione Omarchy inatteso o mancante'
  backup_once "$ENV_FILE"
  backup_once "$SUNSHINE_FILE"
  backup_once "$MONITORS_FILE"
  backup_if_unmanaged "$HEADLESS_HELPER"
  backup_if_unmanaged "$SUNSHINE_DROPIN"

  # AQ_NO_KMS_REQUIREMENT permits Hyprland to run on the NVIDIA DRM device even
  # when the passed-through laptop GPU exposes no physically connected connector.
  # It removes the VirtIO--NVIDIA DMA-BUF hop; the output is created explicitly
  # below rather than with a kernel EDID override.
  replace_or_append "$ENV_FILE" '^export AQ_DRM_DEVICES=.*$' 'export AQ_DRM_DEVICES="/dev/dri/gtx1050"'
  replace_or_append "$ENV_FILE" '^export AQ_NO_KMS_REQUIREMENT=.*$' 'export AQ_NO_KMS_REQUIREMENT=1'
  sed -i '/^export AQ_NO_MODIFIERS=/d' "$ENV_FILE"
  chown "$USER_NAME:$USER_NAME" "$ENV_FILE"

  # Use the Wayland DMA-BUF backend and the NVIDIA encoder on the same GTX.
  # HEVC mode 0 is Sunshine's recommended capability-detection mode: it
  # advertises HEVC only after the active NVENC driver passes the probe.  GTX
  # 1050 Pascal has no hardware AV1 encoder, so do not advertise AV1.
  replace_or_append "$SUNSHINE_FILE" '^capture = .*$' 'capture = wlr'
  replace_or_append "$SUNSHINE_FILE" '^encoder = .*$' 'encoder = nvenc'
  replace_or_append "$SUNSHINE_FILE" '^hevc_mode = .*$' 'hevc_mode = 0'
  replace_or_append "$SUNSHINE_FILE" '^av1_mode = .*$' 'av1_mode = 1'
  replace_or_append "$SUNSHINE_FILE" '^adapter_name = .*$' 'adapter_name = /dev/dri/gtx1050'
  # P3 preserves more quality than P1/P2 while the observed HEVC host-side
  # processing latency remains below 9 ms. Do not lower it merely to mask a
  # resolution/capture mismatch: those are separate problems.
  replace_or_append "$SUNSHINE_FILE" '^nvenc_preset = .*$' 'nvenc_preset = 3'
  chown "$USER_NAME:$USER_NAME" "$SUNSHINE_FILE"

  # Keep one managed block, so running the script again is idempotent and does
  # not duplicate monitor rules after upgrades of the Omarchy defaults. A new
  # installation starts at 16:10, while an existing valid user selection is
  # intentionally preserved across repeated prepare-headless invocations.
  selected_mode="$(managed_stream_mode)"
  if [[ -z "$selected_mode" ]]; then
    selected_mode="$DEFAULT_STREAM_MODE"
  else
    validate_stream_mode "$selected_mode"
  fi
  write_monitor_block "$selected_mode"

  # Sunshine must see a Wayland output before probing the capture backend.  This
  # helper waits for the active Hyprland instance, creates one named output once,
  # and reloads the monitor rule above.  It is a user-service pre-start hook, so
  # it also repairs a manually stopped/restarted Sunshine service.
  install -d -o "$USER_NAME" -g "$USER_NAME" -m 0755 "$(dirname "$HEADLESS_HELPER")" "$(dirname "$SUNSHINE_DROPIN")"
  cat >"$HEADLESS_HELPER" <<'EOF'
#!/usr/bin/env bash
# Managed by omarchy-gtx-primary.  Creates a GTX-only virtual output once.
set -Eeuo pipefail

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
for attempt in {1..40}; do
  signature="$(hyprctl instances 2>/dev/null | awk '/^instance / {gsub(/:$/, "", $2); print $2; exit}')"
  [[ -n "$signature" ]] && break
  sleep 0.25
done
[[ -n "${signature:-}" ]] || { echo 'Hyprland instance not ready' >&2; exit 1; }
export HYPRLAND_INSTANCE_SIGNATURE="$signature"

if ! hyprctl monitors all 2>/dev/null | grep -Fq 'Monitor omarchy-gtx '; then
  hyprctl output create headless omarchy-gtx
fi

# The Lua monitor declaration is applied after the named output exists.
hyprctl reload
hyprctl monitors all 2>/dev/null | grep -Fq 'Monitor omarchy-gtx ' || {
  echo 'omarchy-gtx output was not available after reload' >&2
  exit 1
}
EOF
  chmod 0755 "$HEADLESS_HELPER"
  chown "$USER_NAME:$USER_NAME" "$HEADLESS_HELPER"
  cat >"$SUNSHINE_DROPIN" <<EOF
# Managed by omarchy-gtx-primary.
[Service]
ExecStartPre=$HEADLESS_HELPER
EOF
  chown "$USER_NAME:$USER_NAME" "$SUNSHINE_DROPIN"
  install_user_commands

  # The earlier EDID experiment is not used by the headless design. It is safe
  # to remove only after the Limine drop-in has already been removed by rollback.
  rm -f "$STALE_EDID"
  note "stage pronto con omarchy-gtx $selected_mode: riavviare la sessione grafica con VirtIO ancora presente, verificare omarchy-gtx/NVIDIA/Sunshine; solo dopo impostare vga: none sul nodo"
}

verify_headless() {
  require_root
  local mode
  grep -Fxq 'export AQ_DRM_DEVICES="/dev/dri/gtx1050"' "$ENV_FILE" || die 'AQ_DRM_DEVICES non punta alla GTX'
  grep -Fxq 'export AQ_NO_KMS_REQUIREMENT=1' "$ENV_FILE" || die 'AQ_NO_KMS_REQUIREMENT non abilitato'
  grep -Fxq 'capture = wlr' "$SUNSHINE_FILE" || die 'Sunshine non usa la cattura Wayland wlr'
  grep -Fxq 'encoder = nvenc' "$SUNSHINE_FILE" || die 'Sunshine non richiede NVENC'
  grep -Fxq 'hevc_mode = 0' "$SUNSHINE_FILE" || die 'HEVC non e in rilevamento automatico'
  grep -Fxq 'av1_mode = 1' "$SUNSHINE_FILE" || die 'AV1 deve restare disattivato sulla GTX Pascal'
  grep -Fxq 'adapter_name = /dev/dri/gtx1050' "$SUNSHINE_FILE" || die 'Sunshine non punta alla GTX'
  grep -Fxq 'nvenc_preset = 3' "$SUNSHINE_FILE" || die 'preset NVENC P3 non configurato'
  grep -Fq 'output = "omarchy-gtx"' "$MONITORS_FILE" || die 'monitor headless non configurato'
  mode="$(managed_stream_mode)"
  validate_stream_mode "$mode"
  [[ -x "$HEADLESS_HELPER" ]] || die 'helper di creazione output mancante'
  grep -Fxq "ExecStartPre=$HEADLESS_HELPER" "$SUNSHINE_DROPIN" || die 'pre-start Sunshine mancante'
  [[ -x "$RESOLUTION_COMMAND" && -x "$HEALTH_COMMAND" ]] || die 'comandi utente stream mancanti'
  grep -Fq 'omarchy_stream_resolution()' "$BASHRC" || die 'funzione Bash di risoluzione mancante'
  note "configurazione headless GTX coerente ($mode); controllare a runtime renderer, omarchy-gtx e NVENC"
}

status_runtime() {
  require_root
  local user_id
  user_id="$(id -u "$USER_NAME")"
  note "stato runtime Omarchy/GTX: configurato $(managed_stream_mode) (enc aumenta solo durante uno stream)"
  runuser -u "$USER_NAME" -- env \
    XDG_RUNTIME_DIR="/run/user/$user_id" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$user_id/bus" \
    SUNSHINE_SERVICE="$SUNSHINE_SERVICE" \
    bash -s <<'EOF'
set -Eeuo pipefail
signature="$(hyprctl instances 2>/dev/null | awk '/^instance / {gsub(/:$/, "", $2); print $2; exit}')"
[[ -n "$signature" ]] || { echo 'Hyprland non e attivo'; exit 1; }
export HYPRLAND_INSTANCE_SIGNATURE="$signature"
hyprctl monitors all | sed -n '/^Monitor omarchy-gtx /,/^$/p'
systemctl --user is-active "$SUNSHINE_SERVICE"
nvidia-smi pmon -c 1
EOF
}

apply_runtime_mode() {
  local mode=$1
  user_session_env bash -s -- "$mode" <<'EOF'
set -Eeuo pipefail
mode=$1
signature="$(hyprctl instances 2>/dev/null | awk '/^instance / {gsub(/:$/, "", $2); print $2; exit}')"
[[ -n "$signature" ]] || { echo 'Hyprland non e attivo: modalita salvata ma non ancora applicata' >&2; exit 1; }
export HYPRLAND_INSTANCE_SIGNATURE="$signature"
hyprctl reload
hyprctl monitors all | sed -n '/^Monitor omarchy-gtx /,/^$/p'
EOF
}

set_resolution() {
  require_root
  local mode=${1:-}
  validate_stream_mode "$mode"
  backup_once "$MONITORS_FILE"
  write_monitor_block "$mode"
  note "modalita salvata: omarchy-gtx $mode"
  note 'applico la regola e riavvio Sunshine: lo stream Moonlight corrente verra chiuso'
  apply_runtime_mode "$mode"
  user_session_env systemctl --user daemon-reload
  user_session_env systemctl --user restart "$SUNSHINE_SERVICE"
  note 'Sunshine riavviato: riaprire Desktop da Moonlight e verificare che il log GBM usi la stessa risoluzione'
}

stream_health_once() {
  local mode service_exec pmon sunshine_line enc recent_logs last_gbm
  mode="$(managed_stream_mode)"
  service_exec="$(user_session_env systemctl --user show "$SUNSHINE_SERVICE" -p ExecStart --value 2>/dev/null || true)"
  recent_logs="$(user_session_env journalctl --user -u "$SUNSHINE_SERVICE" --since '20 minutes ago' --no-pager 2>/dev/null || true)"
  last_gbm="$(grep -E '\[wayland\] GBM request: [0-9]+x[0-9]+' <<<"$recent_logs" | tail -n 1 || true)"
  pmon="$(nvidia-smi pmon -c 1 2>/dev/null || true)"
  sunshine_line="$(awk '$NF == "sunshine" { line=$0; enc=$6 } END { if (line != "") print line "\t" enc }' <<<"$pmon")"

  printf 'Configurazione output: omarchy-gtx %s\n' "$mode"
  case "$service_exec" in
    *'/opt/sunshine-cuda12/bin/sunshine'*) echo 'Build Sunshine: CUDA 12 canary selezionato' ;;
    *'/home/'*'/sunshine'*) echo 'Build Sunshine: build GBM/stabile selezionato (non canary CUDA)' ;;
    *) echo 'Build Sunshine: non identificata; controllare ExecStart' ;;
  esac
  grep -Fxq 'encoder = nvenc' "$SUNSHINE_FILE" && echo 'Encoder richiesto: NVENC' || echo 'ATTENZIONE: encoder=nvenc non configurato'
  grep -Fxq 'nvenc_preset = 3' "$SUNSHINE_FILE" && echo 'Preset NVENC: P3 (qualita equilibrata)' || echo 'ATTENZIONE: preset NVENC P3 non configurato'
  if [[ -n "$last_gbm" ]]; then
    echo "Ultima cattura: $last_gbm"
    [[ "$last_gbm" == *"${mode%@*}"* ]] || echo 'ATTENZIONE: superficie GBM e modalita configurata non coincidono; riaprire Moonlight dopo il cambio'
  else
    echo 'Nessuna cattura GBM recente: aprire Desktop da Moonlight prima di valutare il runtime'
  fi
  if grep -Eqi 'libx264|software encoder|couldn.t import rgb image|couldn.t scale frame|invalid argument' <<<"$recent_logs"; then
    echo 'ATTENZIONE: il journal recente contiene fallback software o un errore di import/scala:'
    grep -Ei 'libx264|software encoder|couldn.t import rgb image|couldn.t scale frame|invalid argument' <<<"$recent_logs" | tail -n 8
  else
    echo 'Journal recente: nessun fallback libx264 o errore di import/scala rilevato'
  fi
  if [[ -n "$sunshine_line" ]]; then
    enc="${sunshine_line##*$'\t'}"
    if [[ "$enc" =~ ^[0-9]+$ ]] && (( enc > 0 )); then
      echo "NVENC ATTIVO: sunshine enc=$enc (prova di codifica hardware in questo campione)"
    else
      echo 'NVENC NON OSSERVATO in questo campione: puo essere semplicemente stream inattivo; non e da solo una prova di fallback'
    fi
  else
    echo 'Processo Sunshine non visto in nvidia-smi pmon: aprire Desktop e rieseguire'
  fi
}

stream_health() {
  require_root
  if [[ "${1:-}" == '--watch' ]]; then
    while true; do
      clear
      date '+%F %T'
      stream_health_once
      sleep 1
    done
  fi
  stream_health_once
}

rollback_guest() {
  require_root
  [[ -e "$BACKUP_DIR$ENV_FILE" ]] && cp -a "$BACKUP_DIR$ENV_FILE" "$ENV_FILE"
  [[ -e "$BACKUP_DIR$SUNSHINE_FILE" ]] && cp -a "$BACKUP_DIR$SUNSHINE_FILE" "$SUNSHINE_FILE"
  [[ -e "$BACKUP_DIR$MONITORS_FILE" ]] && cp -a "$BACKUP_DIR$MONITORS_FILE" "$MONITORS_FILE"
  [[ -e "$BACKUP_DIR$HEADLESS_HELPER" ]] && cp -a "$BACKUP_DIR$HEADLESS_HELPER" "$HEADLESS_HELPER" || rm -f "$HEADLESS_HELPER"
  [[ -e "$BACKUP_DIR$SUNSHINE_DROPIN" ]] && cp -a "$BACKUP_DIR$SUNSHINE_DROPIN" "$SUNSHINE_DROPIN" || rm -f "$SUNSHINE_DROPIN"
  [[ -e "$BACKUP_DIR$RESOLUTION_COMMAND" ]] && cp -a "$BACKUP_DIR$RESOLUTION_COMMAND" "$RESOLUTION_COMMAND" || rm -f "$RESOLUTION_COMMAND"
  [[ -e "$BACKUP_DIR$HEALTH_COMMAND" ]] && cp -a "$BACKUP_DIR$HEALTH_COMMAND" "$HEALTH_COMMAND" || rm -f "$HEALTH_COMMAND"
  [[ -e "$BASHRC" ]] && sed -i '/# BEGIN omarchy-gtx-primary commands/,/# END omarchy-gtx-primary commands/d' "$BASHRC"
  note 'file guest ripristinati; systemctl --user daemon-reload; sul nodo lasciare o riportare: qm set 1002 --vga virtio'
}

usage() {
  cat <<'EOF'
Uso: omarchy-gtx-primary <prepare-headless|verify-headless|status-runtime|set-resolution|stream-health|rollback-guest>

  prepare-headless  prepara Hyprland sulla GTX senza display fisico usando
                    AQ_NO_KMS_REQUIREMENT e omarchy-gtx 1920x1200@60 per una
                    nuova installazione; conserva una modalita gia' scelta.
                    Installa un pre-start idempotente: Sunshine avvia la sua
                    cattura solo dopo che l'uscita virtuale esiste.
                    Configura wlr + NVENC sulla GTX, HEVC in rilevamento
                    automatico e AV1 non pubblicizzato (Pascal non lo codifica),
                    piu i comandi Bash omarchy_stream_resolution e
                    omarchy_stream_health.
                    Non modifica kernel, Limine, VBIOS, SSDT o Proxmox.
  verify-headless   controlla i file predisposti prima del riavvio della sessione.
  status-runtime    mostra uscita virtuale, servizio Sunshine e processi NVIDIA.
  set-resolution M  salva e applica M (es. 1920x1200@60), poi riavvia Sunshine.
                    Chiude lo stream Moonlight attivo per negoziare M correttamente.
  stream-health     mostra build, risoluzione GBM, NVENC runtime e fallback;
                    con --watch aggiorna una volta al secondo durante lo stream.
  rollback-guest    ripristina i tre file utente; rimuove (o ripristina) helper
                    drop-in e comandi Sunshine creati dallo script.

Flusso sicuro:
  1. prepare-headless; riavvia SDDM lasciando per ora vga: virtio.
  2. status-runtime; verifica renderer NVIDIA, omarchy-gtx e Sunshine/NVENC
     da SSH/Moonlight. In Moonlight scegli la stessa modalita dell'output.
  3. omarchy_stream_resolution 1920x1200@60 cambia la modalita in modo
     persistente; omarchy_stream_health watch rende visibili fallback/errori.
  4. Solo se il test e' valido: qm set 1002 --vga none e reboot pulito.

Lo script e' idempotente: non duplica righe o backup e usa un blocco monitor gestito.
EOF
}

case "${1:-}" in
  prepare-headless) prepare_headless ;;
  verify-headless) verify_headless ;;
  status-runtime) status_runtime ;;
  set-resolution) set_resolution "${2:-}" ;;
  stream-health) stream_health "${2:-}" ;;
  rollback-guest) rollback_guest ;;
  -h|--help|'') usage ;;
  *) die "azione sconosciuta: $1" ;;
esac
