#!/usr/bin/env bash
# One reproducible entry point for the Proxmox node and the Omarchy guest.
# It deliberately runs in the context that owns the change; it never hides
# remote SSH, passwords, VM shutdowns, or reboots behind a "complete" button.
set -Eeuo pipefail

repo_root="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
# Il wrapper RPM imposta OMARCHY_SETUP_CONFIG nel profilo dell'utente, cosi'
# il pacchetto resta immutabile in /usr e il wizard non richiede un clone Git.
config_file="${OMARCHY_SETUP_CONFIG:-$repo_root/config/omarchy.env}"
apply=0
dry_run=0

die() { printf 'Errore: %s\n' "$*" >&2; exit 1; }
note() { printf '==> %s\n' "$*"; }
require_root() { (( EUID == 0 )) || die 'eseguire come root nel contesto indicato'; }

usage() {
  cat <<'EOF'
Uso:
  scripts/omarchy-setup [--config FILE] onboard [--apply]
  scripts/omarchy-setup [--config FILE] plan
  scripts/omarchy-setup [--config FILE] proxmox gpu-prepare [--apply|--dry-run]
  scripts/omarchy-setup [--config FILE] proxmox gpu-switch [--apply|--dry-run]
  scripts/omarchy-setup [--config FILE] guest sunshine <prepare|verify|status|rollback> [--apply]
  scripts/omarchy-setup [--config FILE] guest microphone <install|verify|add-client> [--apply]
  scripts/omarchy-setup [--config FILE] guest nvidia <pin|verify|patch> [--apply]
  scripts/omarchy-setup [--config FILE] guest steam <fix|verify> [--apply]
  scripts/omarchy-setup [--config FILE] guest steam fallback <enable|disable|status> <app-id|nome-esatto> [--apply]
  scripts/omarchy-setup [--config FILE] guest multi-user <deploy|install|sunshine-api-creds|live-video|wolf|wolf-live-tap|status|users|sessions> [--apply]
  scripts/omarchy-setup [--config FILE] guest all [--apply]
  scripts/omarchy-setup [--config FILE] client fedora <onboard|all|check|moonlight|microphone|kde-connect|show> [--install-key] [--configure-kde-firewall] [--apply]

Prima esecuzione: se il file `--config` manca, la CLI interattiva chiede e
salva le variabili non sensibili. In un terminale non interattivo si ferma e
indica di copiare `config/omarchy.env.example`.

`proxmox` va eseguito come root sul nodo PVE. `guest` va eseguito come root
nella VM Omarchy. Senza opzioni mutanti la CLI stampa soltanto la sequenza e
non richiede root. `--dry-run` usa la simulazione reale di `gpu-vm-switch`
sul nodo PVE: non scrive, ma richiede comunque root e `qm`. Il comando non
effettua SSH remoto e non contiene password.

Il modulo microfono configura un solo flusso vocale attivo alla volta. Puoi
registrare piu' PC, ma non lasciare due client Moonlight con il watcher audio
attivo contemporaneamente: la VM non puo' dedurre quale microfono remoto debba
rispondere a una singola richiesta PipeWire.

`client fedora` si esegue come utente desktop sul PC Fedora, non sul nodo PVE
o nella VM. Senza `--apply` mostra la chiamata riproducibile e non installa
pacchetti, Flatpak, chiavi o servizi.

Per un nuovo PC Fedora il comando unico da ricordare e' `onboard --apply`:
apre il wizard .env se necessario, prepara il firewall RTP nella VM via SSH
con password richiesta nel terminale, poi installa e verifica il client.
EOF
}

load_config() {
  local command_scope=${1:-}
  local client_scope=${2:-}
  ensure_config_file
  # Il file e' locale e amministrato dall'utente; non versionarlo e non usare
  # configurazioni ricevute da fonti non fidate.
  # shellcheck disable=SC1090
  source "$config_file"
  ensure_config_value OMARCHY_USER 'utente Linux della VM Omarchy' "$(id -un)"
  ensure_config_value OMARCHY_VM_HOST 'hostname o IP SSH della VM' 'omarchy.local'
  ensure_config_value OMARCHY_VM_ADDRESS 'indirizzo IP LAN della VM' ''
  ensure_config_value OMARCHY_CLIENT_ADDRESS 'indirizzo IP LAN di questo PC client' ''
  ensure_config_value OMARCHY_RTP_PORT 'porta UDP RTP del microfono' '40100'
  if [[ "$command_scope" == onboard || "$command_scope" == guest || ( "$command_scope" == client && "$client_scope" == fedora ) ]]; then
    ensure_config_default OMARCHY_MIC_DEVICE 'Microphone (USB Audio Device)'
  else
    ensure_config_value OMARCHY_MIC_DEVICE 'nome microfono DirectShow Windows' 'Microphone (USB Audio Device)'
  fi
  # Il valore Pulse speciale e' portabile: un file creato in precedenza per
  # Windows resta quindi utilizzabile anche per l'anteprima Fedora, senza
  # bloccarla su una variabile che puo' essere risolta a runtime dal client.
  if [[ -z "${OMARCHY_FEDORA_MIC_SOURCE:-}" ]]; then
    ensure_config_default OMARCHY_FEDORA_MIC_SOURCE '@DEFAULT_SOURCE@'
  fi
  if [[ "$command_scope" == onboard || ( "$command_scope" == client && "$client_scope" == fedora ) ]]; then
    [[ "$OMARCHY_RTP_PORT" =~ ^[1-9][0-9]{0,4}$ ]] && (( OMARCHY_RTP_PORT <= 65535 )) || die 'OMARCHY_RTP_PORT non valida'
    [[ "$OMARCHY_CLIENT_ADDRESS" =~ ^[0-9a-fA-F:.]+$ ]] || die 'OMARCHY_CLIENT_ADDRESS non valida'
    return 0
  fi
  if [[ "$command_scope" == guest ]]; then
    ensure_config_default OMARCHY_STREAM_MODE '1920x1200@60'
    [[ "$OMARCHY_RTP_PORT" =~ ^[1-9][0-9]{0,4}$ ]] && (( OMARCHY_RTP_PORT <= 65535 )) || die 'OMARCHY_RTP_PORT non valida'
    [[ "$OMARCHY_CLIENT_ADDRESS" =~ ^[0-9a-fA-F:.]+$ ]] || die 'OMARCHY_CLIENT_ADDRESS non valida'
    return 0
  fi
  ensure_config_value OMARCHY_VM_ID 'VMID Proxmox' '1002'
  ensure_config_value OMARCHY_GPU_BDF 'BDF GPU sul nodo PVE' '0000:02:00'
  ensure_config_value OMARCHY_ROM_SOURCE 'percorso VBIOS OEM visto dal repository/nodo' './firmware/gtx1050_hp_native.rom'
  ensure_config_value OMARCHY_STREAM_MODE 'modalita fallback streaming' '1920x1200@60'
  if [[ "$OMARCHY_ROM_SOURCE" != /* ]]; then
    OMARCHY_ROM_SOURCE="$repo_root/${OMARCHY_ROM_SOURCE#./}"
  fi
  [[ "$OMARCHY_RTP_PORT" =~ ^[1-9][0-9]{0,4}$ ]] && (( OMARCHY_RTP_PORT <= 65535 )) || die 'OMARCHY_RTP_PORT non valida'
  [[ "$OMARCHY_CLIENT_ADDRESS" =~ ^[0-9a-fA-F:.]+$ ]] || die 'OMARCHY_CLIENT_ADDRESS non valida'
}

ensure_config_file() {
  [[ -f "$config_file" ]] && return 0
  [[ -t 0 && -t 1 ]] || die "configurazione mancante: $config_file (copia config/omarchy.env.example oppure esegui da un terminale interattivo)"
  note "configurazione mancante: creo $config_file con il wizard locale"
  install -d -m 0700 "$(dirname "$config_file")"
  umask 077
  cat >"$config_file" <<'EOF'
# Creato dal wizard omarchy-setup. Non inserire password, chiavi o token.
# Questo file e' locale e viene ignorato da Git.
EOF
  chmod 0600 "$config_file"
}

ensure_config_default() {
  local key=$1 value=$2
  [[ -z "${!key:-}" ]] || return 0
  printf -v "$key" '%s' "$value"
  printf '%s=%q\n' "$key" "$value" >>"$config_file"
  chmod 0600 "$config_file"
}

ensure_config_value() {
  local key=$1 label=$2 default=$3 value=''
  value="${!key:-}"
  [[ -n "$value" ]] && return 0
  [[ -t 0 && -t 1 ]] || die "$key mancante in $config_file"
  if [[ -n "$default" ]]; then
    read -r -p "$label [$default]: " value
    value="${value:-$default}"
  else
    while [[ -z "$value" ]]; do
      read -r -p "$label: " value
    done
  fi
  printf -v "$key" '%s' "$value"
  printf '%s=%q\n' "$key" "$value" >>"$config_file"
  chmod 0600 "$config_file"
}

user_systemctl() {
  local uid
  uid="$(id -u "$OMARCHY_USER")"
  runuser -u "$OMARCHY_USER" -- env \
    XDG_RUNTIME_DIR="/run/user/$uid" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus" \
    systemctl --user "$@"
}

ensure_mediamtx() {
  local latest_tag tmp_dir
  if command -v mediamtx >/dev/null; then
    note "verifico aggiornamenti MediaMTX (versione attuale: $(mediamtx --version 2>/dev/null || echo sconosciuta))..."
    mediamtx --upgrade >/dev/null 2>&1 || true
    return 0
  fi
  note "download e installazione dell'ultima versione di MediaMTX da GitHub..."
  latest_tag="$(curl -fsSL https://api.github.com/repos/bluenviron/mediamtx/releases/latest 2>/dev/null | grep -o '"tag_name": *"[^"]*"' | cut -d'"' -f4 || true)"
  [[ -n "$latest_tag" ]] || latest_tag="v1.21.1"
  tmp_dir="$(mktemp -d)"
  local base="https://github.com/bluenviron/mediamtx/releases/download/${latest_tag}"
  local archive="mediamtx_${latest_tag}_linux_amd64.tar.gz"
  # Verify the archive against the release's checksums before installing as root.
  if curl -fsSL -o "$tmp_dir/$archive" "$base/$archive" \
     && curl -fsSL -o "$tmp_dir/checksums.sha256" "$base/checksums.sha256" \
     && (cd "$tmp_dir" && grep " \*\?$archive\$" checksums.sha256 | sed 's/ \*/  /' | sha256sum -c --quiet -) \
     && tar -xzf "$tmp_dir/$archive" -C "$tmp_dir" mediamtx; then
    install -m 0755 "$tmp_dir/mediamtx" /usr/local/bin/mediamtx
    ln -sf /usr/local/bin/mediamtx /usr/bin/mediamtx
    rm -rf "$tmp_dir"
    note "MediaMTX ($latest_tag) installato con successo"
  else
    rm -rf "$tmp_dir"
    die "MediaMTX non installato: download fallito o checksum non valido (installa mediamtx-bin da AUR)"
  fi
}

# Credentials the session broker uses for Sunshine's web API (PIN pairing).
# Sunshine has a single web-manager account, so this is also the password of
# the Sunshine web UI. Generated here, applied with Sunshine's own CLI and
# stored only in a root-only file: never in the repository, never printed.
configure_sunshine_api_credentials() {
  local force=${1:-0} env_file=${OMARCHY_SUNSHINE_API_ENV:-/etc/omarchy/sunshine-api.env} api_user password home tmp
  require_root
  if (( ! force )) && [[ -s "$env_file" ]] && grep -q '^SUNSHINE_API_PASSWORD=.' "$env_file"; then
    note "credenziali API Sunshine già presenti in $env_file (non modificate)"
    return 0
  fi
  command -v sunshine >/dev/null || die 'sunshine non installato: impossibile impostare le credenziali API'
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || die "home non trovata per $OMARCHY_USER"
  api_user="${OMARCHY_SUNSHINE_API_USER:-admin}"
  # Hex only: a leading "-" could be parsed by sunshine as an option.
  password="$(python3 -c 'import secrets; print(secrets.token_hex(20))')"

  # Note: the password is briefly visible in this process's argv (sunshine
  # --creds has no stdin form); the command exits immediately.
  if ! runuser -u "$OMARCHY_USER" -- env HOME="$home" XDG_CONFIG_HOME="$home/.config" \
       sunshine --creds "$api_user" "$password" >/dev/null 2>&1; then
    unset password
    die 'sunshine --creds non riuscito: credenziali invariate'
  fi

  install -d -m 0755 "$(dirname "$env_file")"
  tmp="$(mktemp "$(dirname "$env_file")/.sunshine-api.env.XXXXXX")"
  chmod 0600 "$tmp"
  printf '# Generato da omarchy-setup: credenziali web API di Sunshine (solo root)\nSUNSHINE_API_USER=%s\nSUNSHINE_API_PASSWORD=%s\n' \
    "$api_user" "$password" > "$tmp"
  unset password
  chown root:root "$tmp"
  mv -f "$tmp" "$env_file"

  # Sunshine loads the web credentials at startup only.
  user_systemctl try-restart app-dev.lizardbyte.app.Sunshine.service \
    || note 'riavvia Sunshine per applicare le nuove credenziali'
  note "credenziali API Sunshine aggiornate in $env_file (leggibili solo da root, anche per la web UI di Sunshine)"
}

# Installs only the packages that are not installed yet. `pacman -S --needed`
# still resolves already-installed ones against the (possibly newer) sync
# database, and a single newer library is a partial upgrade pacman refuses.
pacman_install_missing() {
  local pkg missing=()
  for pkg in "$@"; do pacman -Qq "$pkg" >/dev/null 2>&1 || missing+=("$pkg"); done
  (( ${#missing[@]} )) || return 0
  pacman -S --needed --noconfirm "${missing[@]}"
}

install_live_video() {
  local home xdph
  require_root
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || die "home non trovata per $OMARCHY_USER"
  pacman_install_missing gpu-screen-recorder wf-recorder ffmpeg \
    || note 'gpu-screen-recorder/wf-recorder/ffmpeg: installali manualmente se non presenti nei repository'
  ensure_mediamtx

  # Pascal / NVIDIA 580xx: distro gsr needs NVENC API 13.1, build it against
  # the legacy-NVENC FFmpeg so the full-GPU capture path works.
  install -m 0755 "$repo_root/scripts/omarchy-build-gsr-legacy-nvenc" /usr/local/bin/omarchy-build-gsr-legacy-nvenc
  if [[ -f /opt/ffmpeg-nvenc/usr/lib/pkgconfig/libavcodec.pc ]]; then
    pacman_install_missing git base-devel ninja vulkan-headers \
      || note 'strumenti di build non installati: provo comunque'
    omarchy-build-gsr-legacy-nvenc || note 'build gsr legacy NVENC fallita: resterà il fallback wf-recorder'
  fi
  install -m 0755 "$repo_root/scripts/omarchy-capture-publish" /usr/local/bin/omarchy-capture-publish
  install -m 0755 "$repo_root/scripts/omarchy-capture-picker" /usr/local/bin/omarchy-capture-picker
  install -d -m 0755 /etc/omarchy
  install -m 0644 "$repo_root/config/mediamtx-omarchy.yml" /etc/omarchy/mediamtx.yml
  [[ -f /etc/omarchy/capture-output ]] || printf 'omarchy-gtx\n' > /etc/omarchy/capture-output
  sed -e "s/^Environment=OMARCHY_DESKTOP_USER=.*/Environment=OMARCHY_DESKTOP_USER=$OMARCHY_USER/" \
    "$repo_root/systemd/omarchy-mediamtx.service" > /etc/systemd/system/omarchy-mediamtx.service
  # shmsrc (Wolf live tap) lives in gst-plugins-bad; skip pacman when it is
  # already there: installing one package against a newer sync database is a
  # partial upgrade and pacman refuses it (gst-plugin-gtk pins the old version).
  gst-inspect-1.0 shmsrc >/dev/null 2>&1 || pacman_install_missing gstreamer gst-plugins-bad \
    || note 'gstreamer/gst-plugins-bad (shmsrc) servono per il video delle sessioni Wolf: aggiorna il sistema (pacman -Syu) e riprova'

  # gpu-screen-recorder captures the headless output through the ScreenCast
  # portal; answer its picker automatically (nobody can click on this host).
  xdph="$home/.config/hypr/xdph.conf"
  install -d -o "$OMARCHY_USER" -g "$OMARCHY_USER" "$(dirname "$xdph")"
  if ! grep -q '^\s*custom_picker_binary\s*=\s*/usr/local/bin/omarchy-capture-picker' "$xdph" 2>/dev/null; then
    [[ -f "$xdph" ]] && cp -p "$xdph" "$xdph.omarchy-bak"
    if grep -q '^\s*custom_picker_binary\s*=' "$xdph" 2>/dev/null; then
      # Omarchy ships its own (interactive) picker: replace that line only.
      sed -i 's|^\(\s*custom_picker_binary\s*=\).*|\1 /usr/local/bin/omarchy-capture-picker|' "$xdph"
    else
      printf '\n# Managed by omarchy-setup: automatic share picker for live view/recordings\nscreencopy {\n    custom_picker_binary = /usr/local/bin/omarchy-capture-picker\n    allow_token_by_default = true\n}\n' >> "$xdph"
    fi
    chown "$OMARCHY_USER:$OMARCHY_USER" "$xdph"
    user_systemctl restart xdg-desktop-portal-hyprland.service || note 'riavvia la sessione Hyprland per applicare xdph.conf'
  fi

  # WebRTC media only (signalling stays on loopback behind the broker).
  if command -v ufw >/dev/null; then
    ufw allow 8189/udp comment 'Omarchy live WebRTC media'
    ufw allow 8189/tcp comment 'Omarchy live WebRTC ICE-TCP'
  fi
  systemctl daemon-reload
  systemctl enable --now omarchy-mediamtx.service
}

configure_moonlight_boot() {
  local home sddm_file stay_awake
  require_root
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || die "home non trovata per $OMARCHY_USER"

  # Sunshine captures the user Wayland session, therefore the session must
  # exist after a VM boot. This happens after any encrypted root volume has
  # been unlocked. Keep this in a final SDDM drop-in rather than modifying
  # Omarchy's package-owned configuration.
  sddm_file='/etc/sddm.conf.d/zz-omarchy-moonlight-autologin.conf'
  install -d -m 0755 /etc/sddm.conf.d
  cat >"$sddm_file" <<EOF
# Managed by omarchy-setup for a dedicated Moonlight guest.
[Autologin]
User=$OMARCHY_USER
Session=omarchy.desktop
EOF
  chmod 0644 "$sddm_file"

  # Omarchy's supported persistent "stay awake" state disables only idle
  # screensaver/lock. Its separate sleep hook still locks before suspend.
  stay_awake="$home/.local/state/omarchy/indicators/stay-awake"
  install -d -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0700 "$(dirname "$stay_awake")"
  install -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0600 /dev/null "$stay_awake"
  note "sessione Moonlight pronta dopo lo sblocco LUKS: autologin SDDM per $OMARCHY_USER e idle lock disabilitato"
}

verify_moonlight_boot() {
  local home sddm_file stay_awake
  require_root
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  sddm_file='/etc/sddm.conf.d/zz-omarchy-moonlight-autologin.conf'
  stay_awake="$home/.local/state/omarchy/indicators/stay-awake"
  grep -Fxq "User=$OMARCHY_USER" "$sddm_file" || die 'autologin SDDM non configurato per l’utente Omarchy'
  grep -Fxq 'Session=omarchy.desktop' "$sddm_file" || die 'sessione SDDM Omarchy non configurata'
  [[ -f "$stay_awake" ]] || die 'stay awake persistente non configurato'
  note 'boot Moonlight verificato: SDDM autologin e stay awake persistente'
}

write_ptt_bindings() {
  local home bindings backup
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || die "home non trovata per $OMARCHY_USER"
  bindings="$home/.config/hypr/bindings.lua"
  [[ -f "$bindings" ]] || die "bindings Hyprland non trovato: $bindings"
  backup="$home/.config/omarchy-setup-backups/bindings.lua.before-voxtype"
  if [[ ! -e "$backup" ]]; then
    install -d -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0700 "$(dirname "$backup")"
    cp -a "$bindings" "$backup"
  fi
  sed -i '/-- BEGIN omarchy-setup voxtype microphone/,/-- END omarchy-setup voxtype microphone/d' "$bindings"
  # Replace precisely the earlier manual copies made for the same PTT. Leave
  # unrelated personal bindings untouched.
  sed -i '/o\.bind("SUPER + H", "Voxtype PTT /d; /o\.bind("HOME", "Voxtype PTT /d' "$bindings"
  cat >>"$bindings" <<'EOF'

-- BEGIN omarchy-setup voxtype microphone
-- The remote microphone is armed first, then VoxType records after a short
-- RTP pre-roll. Caps Lock is mapped to Super on the original Windows client.
o.bind("SUPER + H", "Voxtype PTT start (Caps Lock + H)", "bash -c 'voxtype-remote-mic-demand arm; sleep 0.18; test -e /run/user/$(id -u)/voxtype/remote-mic-demand && voxtype record start'")
o.bind("SUPER + H", "Voxtype PTT stop (Caps Lock + H)", "bash -c 'voxtype record stop; voxtype-remote-mic-demand disarm'", { release = true })
o.bind("HOME", "Voxtype PTT start (Home)", "bash -c 'voxtype-remote-mic-demand arm; sleep 0.18; test -e /run/user/$(id -u)/voxtype/remote-mic-demand && voxtype record start'")
o.bind("HOME", "Voxtype PTT stop (Home)", "bash -c 'voxtype record stop; voxtype-remote-mic-demand disarm'", { release = true })
-- END omarchy-setup voxtype microphone
EOF
  chown "$OMARCHY_USER:$OMARCHY_USER" "$bindings"
}

install_microphone() {
  require_root
  local home bin_dir unit_dir env_file service_file
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  [[ -n "$home" && -d "$home" ]] || die "home non trovata per $OMARCHY_USER"
  command -v ffmpeg >/dev/null || die 'ffmpeg mancante nella VM'
  command -v pactl >/dev/null || die 'pactl/PipeWire Pulse mancante nella VM'
  command -v pw-cat >/dev/null || die 'pw-cat mancante nella VM'
  command -v voxtype >/dev/null || die 'VoxType non installato nella VM'
  bin_dir="$home/.local/bin"
  unit_dir="$home/.config/systemd/user"
  env_file="$home/.config/voxtype/remote-mic.env"
  service_file="$unit_dir/voxtype-remote-mic-rtp.service"
  install -d -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0755 "$bin_dir" "$unit_dir" "$(dirname "$env_file")"
  install -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0755 \
    "$repo_root/scripts/voxtype-remote-mic-rtp-receive" \
    "$repo_root/scripts/voxtype-remote-mic-control-follow" \
    "$repo_root/scripts/voxtype-remote-mic-demand" \
    "$repo_root/scripts/voxtype-remote-mic-ssh-dispatch" \
    -t "$bin_dir"
  printf 'VOXTYPE_RTP_PORT=%s\n' "$OMARCHY_RTP_PORT" >"$env_file"
  chown "$OMARCHY_USER:$OMARCHY_USER" "$env_file"
  install -o "$OMARCHY_USER" -g "$OMARCHY_USER" -m 0644 \
    "$repo_root/systemd/voxtype-remote-mic-rtp.service" "$service_file"
  loginctl enable-linger "$OMARCHY_USER"
  user_systemctl daemon-reload
  user_systemctl enable --now voxtype-remote-mic-rtp.service
  ufw allow from "$OMARCHY_CLIENT_ADDRESS" to any port "$OMARCHY_RTP_PORT" proto udp \
    comment "Omarchy Voxtype RTP microphone"
  write_ptt_bindings
  note "microfono VM pronto: UDP $OMARCHY_RTP_PORT ammessa solo da $OMARCHY_CLIENT_ADDRESS"
  note 'installa poi chiave e autostart dal client Windows o Fedora con il rispettivo modulo clients'
}

verify_microphone() {
  require_root
  local home env_file
  home="$(getent passwd "$OMARCHY_USER" | cut -d: -f6)"
  env_file="$home/.config/voxtype/remote-mic.env"
  [[ -r "$env_file" ]] || die "configurazione microfono mancante: $env_file"
  grep -Fxq "VOXTYPE_RTP_PORT=$OMARCHY_RTP_PORT" "$env_file" || die 'porta del servizio diversa dalla configurazione locale'
  user_systemctl is-enabled voxtype-remote-mic-rtp.service
  user_systemctl is-active voxtype-remote-mic-rtp.service
  loginctl show-user "$OMARCHY_USER" -p Linger
  pactl list short sources | grep -F 'voxtype_remote_mic.monitor'
  note 'controllo completato; l’assenza di un processo FFmpeg Windows a riposo e normale e desiderata'
}

proxmox_gpu_prepare() {
  local args=(--prepare-host --gpu "$OMARCHY_GPU_BDF" --rom-source "$OMARCHY_ROM_SOURCE")
  if (( apply )); then
    require_root
    "$repo_root/scripts/gpu-vm-switch" "${args[@]}"
  elif (( dry_run )); then
    require_root
    "$repo_root/scripts/gpu-vm-switch" "${args[@]}" --dry-run --yes
  else
    note "anteprima: $repo_root/scripts/gpu-vm-switch --prepare-host --gpu $OMARCHY_GPU_BDF --rom-source $OMARCHY_ROM_SOURCE --dry-run --yes"
  fi
}

proxmox_gpu_switch() {
  local args=(--vm "$OMARCHY_VM_ID" --gpu "$OMARCHY_GPU_BDF")
  if (( apply )); then
    require_root
    "$repo_root/scripts/gpu-vm-switch" "${args[@]}"
  elif (( dry_run )); then
    require_root
    "$repo_root/scripts/gpu-vm-switch" "${args[@]}" --dry-run --yes
  else
    note "anteprima: $repo_root/scripts/gpu-vm-switch --vm $OMARCHY_VM_ID --gpu $OMARCHY_GPU_BDF --dry-run --yes"
  fi
}

guest_sunshine() {
  local action=$1 gtx_action
  case "$action" in
    prepare) gtx_action=prepare-headless ;;
    verify) gtx_action=verify-headless ;;
    status) gtx_action=status-runtime ;;
    rollback) gtx_action=rollback-guest ;;
    *) die "azione Sunshine non valida: $action" ;;
  esac
  if (( ! apply )) && [[ "$action" != verify && "$action" != status ]]; then
    note "anteprima: OMARCHY_USER=$OMARCHY_USER $repo_root/scripts/omarchy-gtx-primary $gtx_action"
    [[ "$action" != prepare ]] || note "anteprima: configuro autologin SDDM e stay awake persistente per $OMARCHY_USER"
    return 0
  fi
  require_root
  OMARCHY_USER="$OMARCHY_USER" "$repo_root/scripts/omarchy-gtx-primary" "$gtx_action"
  case "$action" in
    prepare) configure_moonlight_boot; verify_moonlight_boot ;;
    verify) verify_moonlight_boot ;;
  esac
}

guest_steam() {
  local action=$1 fallback_action=${2:-} app_id=${3:-}
  case "$action" in
    fix)
      if (( apply )); then require_root; "$repo_root/scripts/omarchy-steam-pascal-fix" apply
      else note "anteprima: sudo $repo_root/scripts/omarchy-steam-pascal-fix apply"; fi ;;
    verify) "$repo_root/scripts/omarchy-steam-pascal-fix" verify ;;
    fallback)
      case "$fallback_action" in
        enable|disable)
          [[ -n "$app_id" ]] || die 'Steam fallback richiede un AppID o il nome esatto del gioco'
          if (( apply )); then
            require_root
            OMARCHY_USER="$OMARCHY_USER" "$repo_root/scripts/omarchy-steam-xwayland-fallback" "$fallback_action" "$app_id"
          else
            note "anteprima: chiudi Steam, poi sudo OMARCHY_USER=$OMARCHY_USER $repo_root/scripts/omarchy-steam-xwayland-fallback $fallback_action $app_id"
          fi
          ;;
        status)
          [[ -n "$app_id" ]] || die 'Steam fallback richiede un AppID o il nome esatto del gioco'
          OMARCHY_USER="$OMARCHY_USER" "$repo_root/scripts/omarchy-steam-xwayland-fallback" status "$app_id"
          ;;
        *) die 'azione Steam fallback: enable, disable oppure status' ;;
      esac
      ;;
    *) die 'azione Steam: fix, verify oppure fallback' ;;
  esac
}

guest_nvidia() {
  local action=$1
  case "$action" in
    pin)
      if (( apply )); then
        require_root
        "$repo_root/scripts/omarchy-nvidia-pascal-branch" apply
      else
        note "anteprima: sudo $repo_root/scripts/omarchy-nvidia-pascal-branch apply"
      fi
      ;;
    verify) "$repo_root/scripts/omarchy-nvidia-pascal-branch" verify ;;
    patch)
      if (( apply )); then
        require_root
        install -m 0755 "$repo_root/scripts/omarchy-patch-nvenc" /usr/local/bin/omarchy-patch-nvenc
        omarchy-patch-nvenc apply
      else
        "$repo_root/scripts/omarchy-patch-nvenc" status
        note "anteprima: rimozione limite sessioni NVENC con keylase nvidia-patch e sync container Wolf"
      fi
      ;;
    *) die 'azione NVIDIA: pin, verify oppure patch' ;;
  esac
}

client_fedora() {
  local action=$1
  local args=(--config "$config_file" --module "$action")
  (( client_install_key )) && args+=(--install-key)
  (( client_configure_kde_firewall )) && args+=(--configure-kde-firewall)
  if (( apply )) || [[ "$action" == show || "$action" == check ]]; then
    "$repo_root/clients/omarchy-client-setup-fedora.sh" "${args[@]}"
  else
    note "anteprima Fedora: $repo_root/clients/omarchy-client-setup-fedora.sh ${args[*]}"
  fi
}

show_plan() {
  cat <<EOF
1. [NODO PVE]  scripts/omarchy-setup --config $config_file proxmox gpu-prepare --apply
2. [NODO PVE]  scripts/omarchy-setup --config $config_file proxmox gpu-switch --apply
3. [VM]        scripts/omarchy-setup --config $config_file guest sunshine prepare --apply
4. [VM]        scripts/omarchy-setup --config $config_file guest microphone install --apply
5. [CLIENT]    Windows: .\\clients\\omarchy-client-setup.ps1 -ConfigPath .\\config\\omarchy.env -Module Microphone -InstallKey
               Fedora: scripts/omarchy-setup onboard --apply
               (wizard: UFW VM, chiave, Moonlight, microfono, KDE Connect, verifica)
6. [CLIENT]    Facoltativo: client fedora check oppure client fedora show
7. [VM]        scripts/omarchy-setup --config $config_file guest sunshine status
8. [VM]        scripts/omarchy-setup --config $config_file guest microphone verify
EOF
}

positionals=()
client_install_key=0
client_configure_kde_firewall=0
while (( $# )); do
  case "$1" in
    --config) (( $# >= 2 )) || die '--config richiede un file'; config_file=$2; shift 2 ;;
    --apply) apply=1; shift ;;
    --dry-run) dry_run=1; shift ;;
    --install-key) client_install_key=1; shift ;;
    --configure-kde-firewall) client_configure_kde_firewall=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) positionals+=("$1"); shift ;;
  esac
done
set -- "${positionals[@]}"
(( $# >= 1 )) || { usage >&2; exit 2; }
(( ! (apply && dry_run) )) || die '--apply e --dry-run sono alternativi'
load_config "$@"

case "$1" in
  onboard)
    [[ $# -eq 1 ]] || die 'onboard non accetta altri argomenti; eseguilo dal desktop Fedora'
    client_fedora onboard
    ;;
  plan) [[ $# -eq 1 ]] || die 'plan non accetta altri argomenti'; show_plan ;;
  proxmox)
    case "${2:-}" in
      gpu-prepare) proxmox_gpu_prepare ;;
      gpu-switch) proxmox_gpu_switch ;;
      *) die 'modulo Proxmox: gpu-prepare oppure gpu-switch' ;;
    esac ;;
  guest)
    case "${2:-}" in
      sunshine) case "${3:-}" in prepare|verify|status|rollback) guest_sunshine "$3" ;; *) die 'azione Sunshine non valida' ;; esac ;;
      microphone)
        case "${3:-}" in
          install) if (( apply )); then install_microphone; else note 'anteprima: installazione file, servizio utente, linger, UFW e binding PTT'; fi ;;
          verify) verify_microphone ;;
          add-client)
            if (( apply )); then require_root; ufw allow from "$OMARCHY_CLIENT_ADDRESS" to any port "$OMARCHY_RTP_PORT" proto udp comment 'Omarchy Voxtype RTP microphone'; else note "anteprima: abilito $OMARCHY_CLIENT_ADDRESS -> UDP $OMARCHY_RTP_PORT"; fi ;;
          *) die 'azione microfono: install, verify oppure add-client' ;;
        esac ;;
      steam) guest_steam "${3:-}" "${4:-}" "${5:-}" ;;
      nvidia) guest_nvidia "${3:-}" ;;
      multi-user)
        case "${3:-}" in
          install)
            if (( apply )); then
              require_root
              install -m 0755 "$repo_root/scripts/omarchy-session-broker" /usr/local/bin/omarchy-session-broker
              install -m 0644 "$repo_root/systemd/omarchy-session-broker.service" /etc/systemd/system/omarchy-session-broker.service
              install -m 0644 "$repo_root/systemd/omarchy-storage-prune.service" "$repo_root/systemd/omarchy-storage-prune.timer" /etc/systemd/system/
              install -m 0755 "$repo_root/scripts/omarchy-resource-reaper" /usr/local/bin/omarchy-resource-reaper
              install -m 0644 "$repo_root/systemd/omarchy-resource-reaper.service" /etc/systemd/system/omarchy-resource-reaper.service
              install -m 0644 "$repo_root/systemd/omarchy-resource-reaper.timer" /etc/systemd/system/omarchy-resource-reaper.timer
              systemctl daemon-reload
              ( configure_sunshine_api_credentials ) \
                || note 'credenziali API Sunshine non impostate: pairing Sunshine non disponibile finché non esegui guest multi-user sunshine-api-creds --apply'
              systemctl enable --now omarchy-session-broker.service
              systemctl enable --now omarchy-resource-reaper.timer
              omarchy-session-broker install-backend
            else
              note 'anteprima: installazione omarchy-session-broker, omarchy-resource-reaper timer, credenziali API Sunshine casuali e database SQLite'
            fi
            ;;
          reaper)
            if (( apply )); then
              require_root
              install -m 0755 "$repo_root/scripts/omarchy-resource-reaper" /usr/local/bin/omarchy-resource-reaper
              install -m 0644 "$repo_root/systemd/omarchy-resource-reaper.service" /etc/systemd/system/omarchy-resource-reaper.service
              install -m 0644 "$repo_root/systemd/omarchy-resource-reaper.timer" /etc/systemd/system/omarchy-resource-reaper.timer
              systemctl daemon-reload
              systemctl enable --now omarchy-resource-reaper.timer
              /usr/local/bin/omarchy-resource-reaper --verbose
            else
              note 'anteprima: installazione omarchy-resource-reaper (timer periodico 30 min per bonifica loop orfani, log e risorse)'
            fi
            ;;
          deploy)
            # Everything the server needs, in order, with one sudo command.
            if (( apply )); then
              require_root
              "$0" --config "$config_file" guest multi-user install --apply
              "$0" --config "$config_file" guest multi-user live-video --apply
              "$0" --config "$config_file" guest multi-user wolf --apply
              install -m 0755 "$repo_root/scripts/omarchy-session-broker" /usr/local/bin/omarchy-session-broker
              systemctl restart omarchy-session-broker.service
              note 'deploy completato: broker, credenziali Sunshine, video live (MediaMTX), Wolf + profili + tap'
            else
              note 'anteprima: install + live-video + wolf (broker, credenziali Sunshine, MediaMTX, gsr legacy NVENC, Wolf, Wolf UI multi-utente, profili, tap live)'
            fi
            ;;
          sunshine-api-creds)
            if (( apply )); then
              configure_sunshine_api_credentials 1
            else
              note 'anteprima: nuova password casuale per la web API di Sunshine in /etc/omarchy/sunshine-api.env (riavvia Sunshine)'
            fi
            ;;
          live-video)
            if (( apply )); then
              install_live_video
            else
              note 'anteprima: gpu-screen-recorder + MediaMTX (WebRTC H.265), picker portale automatico, UFW 8189 udp/tcp'
            fi
            ;;
          wolf)
            if (( apply )); then
              require_root
              pacman_install_missing docker docker-compose >/dev/null || note 'installa docker e docker-compose'
              systemctl enable --now docker.service
              "$repo_root/scripts/omarchy-wolf-install" apply --repo "$repo_root"
            else
              "$repo_root/scripts/omarchy-wolf-install" check --repo "$repo_root" || true
              note 'anteprima: Wolf in Docker (driver volume NVIDIA, porte 49984-50200), tap live, UFW'
            fi
            ;;
          wolf-live-tap)
            if (( apply )); then
              require_root
              install -m 0755 "$repo_root/scripts/omarchy-wolf-live-tap" /usr/local/bin/omarchy-wolf-live-tap
              install -Dm0644 "$repo_root/packaging/wolf/unixfd-heap-memory.patch" /usr/share/omarchy/wolf/unixfd-heap-memory.patch
              [[ -f /etc/omarchy/wolf/gst-plugins/libgstunixfd.so ]] || omarchy-wolf-live-tap build-unixfd
              omarchy-wolf-live-tap apply
            else
              "$repo_root/scripts/omarchy-wolf-live-tap" status
              note 'anteprima: tee dello stream NVENC di Wolf verso /tmp/sockets (backup di config.toml, GOP 2 s)'
            fi
            ;;
          status) "$repo_root/scripts/omarchy-session-broker" status-json ;;
          users) "$repo_root/scripts/omarchy-session-broker" list-users ;;
          sessions) "$repo_root/scripts/omarchy-session-broker" list-sessions ;;
          *) die 'azione multi-user: install, reaper, live-video, wolf, wolf-live-tap, status, users oppure sessions' ;;
        esac ;;
      all)
        if (( apply )); then guest_nvidia pin; guest_sunshine prepare; install_microphone; else note 'anteprima: guardia driver 580xx + Sunshine headless + ricevitore microfono/pipewire/PTT'; fi ;;
      *) die 'modulo guest: sunshine, microphone, nvidia, steam, multi-user oppure all' ;;
    esac ;;
  client)
    case "${2:-}" in
      fedora)
        case "${3:-}" in onboard|all|check|moonlight|microphone|kde-connect|show) client_fedora "$3" ;; *) die 'modulo client Fedora: onboard, all, check, moonlight, microphone, kde-connect oppure show' ;; esac
        ;;
      *) die 'modulo client: fedora' ;;
    esac ;;
  *) usage >&2; exit 2 ;;
esac
