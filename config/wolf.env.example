# Omarchy Wolf (Games on Whales) - valori usati da scripts/omarchy-wolf-install
# (scritti in /etc/omarchy/wolf/.env). Nomi verificati nel sorgente di Wolf
# (games-on-whales/wolf, utils::get_env): Wolf non ha variabili di "session
# sharing"; la condivisione di una sessione tra piu' client Moonlight si fa con
# le lobby dell'API (/api/v1/lobbies/create con multi_user, /api/v1/lobbies/join).

# Render/encode sulla GTX: il default /dev/dri/renderD128 su questa VM e' la
# GPU virtio di Proxmox. L'installer rileva il nodo NVIDIA automaticamente.
WOLF_RENDER_NODE=/dev/dri/renderD129

# Porte Moonlight di Wolf, spostate perche' Sunshine usa gia' quelle standard.
# In Moonlight: aggiungi il PC come <ip-vm>:49989
WOLF_HTTP_PORT=49989
WOLF_HTTPS_PORT=49984
WOLF_CONTROL_PORT=49999
WOLF_RTSP_SETUP_PORT=50010
WOLF_VIDEO_PING_PORT=50100
WOLF_AUDIO_PING_PORT=50200

# Socket API usato dal session broker (montato dal container).
WOLF_SOCKET_PATH=/var/run/wolf/wolf.sock
