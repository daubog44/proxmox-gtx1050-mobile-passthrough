# Omarchy - credenziali della web API di Sunshine usate dal session broker
# per il pairing PIN (POST https://127.0.0.1:47990/api/pin).
#
# Il file reale e' /etc/omarchy/sunshine-api.env: proprietario root, permessi 0600.
# Non va creato a mano ne' versionato: lo genera
#   sudo scripts/omarchy-setup guest multi-user install --apply
# e lo ruota (nuova password casuale, applicata con `sunshine --creds`)
#   sudo scripts/omarchy-setup guest multi-user sunshine-api-creds --apply
#
# Sunshine ha un solo account web: questa e' anche la password della web UI
# di Sunshine (https://<ip-vm>:47990). Per leggerla: sudo cat /etc/omarchy/sunshine-api.env
SUNSHINE_API_USER=admin
SUNSHINE_API_PASSWORD=
