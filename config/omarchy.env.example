# Copia questo file in config/omarchy.env e sostituisci ogni valore.
# Il file reale e' ignorato da Git: puo' contenere indirizzi della tua LAN e
# il nome locale del microfono, ma non inserire password o chiavi private.

# Identita' della VM Omarchy.
OMARCHY_USER=your-linux-user
OMARCHY_VM_HOST=omarchy.local
OMARCHY_VM_ADDRESS=192.168.1.50

# PC Windows che invia il proprio microfono alla VM. Per aggiungere un altro
# PC, copia il file su quel PC e cambia solo questo indirizzo e il dispositivo.
OMARCHY_CLIENT_ADDRESS=192.168.1.60
OMARCHY_RTP_PORT=40100
OMARCHY_MIC_DEVICE='Microphone (USB Audio Device)'

# Passthrough GPU sul nodo Proxmox. Il percorso ROM e' visto dal nodo, non
# da Windows o dal guest.
OMARCHY_VM_ID=1002
OMARCHY_GPU_BDF=0000:02:00
OMARCHY_ROM_SOURCE=./firmware/gtx1050_hp_native.rom
OMARCHY_STREAM_MODE=1920x1200@60
