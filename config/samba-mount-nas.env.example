# Configurazione del punto di mount Samba NAS per la registrazione sessioni Omarchy
# Target specificato: smb://192.168.0.39/nvme1

SAMBA_SERVER="192.168.0.39"
SAMBA_SHARE="//192.168.0.39/nvme1"
SAMBA_MOUNTPOINT="/mnt/nvme1-recordings"
SAMBA_SUBDIR="omarchy-recordings"

# Credenziali Samba (se la share richiede autenticazione)
# Lasciare vuoto se l'accesso è anonimo / guest
SAMBA_USERNAME=""
SAMBA_PASSWORD=""
SAMBA_WORKGROUP="WORKGROUP"

# Opzioni di montaggio per /etc/fstab:
# //192.168.0.39/nvme1 /mnt/nvme1-recordings cifs guest,uid=1000,gid=1000,iocharset=utf8 0 0
