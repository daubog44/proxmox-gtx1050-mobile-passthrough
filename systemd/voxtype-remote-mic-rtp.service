[Unit]
Description=Voxtype low-latency RTP microphone receiver
After=pipewire.service
Wants=pipewire.service

[Service]
Type=simple
EnvironmentFile=-%h/.config/voxtype/remote-mic.env
ExecStart=%h/.local/bin/voxtype-remote-mic-rtp-receive ${VOXTYPE_RTP_PORT}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
