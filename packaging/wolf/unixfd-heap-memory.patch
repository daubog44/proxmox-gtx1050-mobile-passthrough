+/* Backport heap-memory support for mpegtsmux to the Wolf GStreamer 1.26 ABI.
+ * Use GStreamer's native memfd allocator; encoded bytes are never re-encoded. */
+static GstFlowReturn gst_unix_fd_sink_render_fd (GstBaseSink *, GstBuffer *);
+
 static GstFlowReturn
 gst_unix_fd_sink_render (GstBaseSink * bsink, GstBuffer * buffer)
+{
+  GstUnixFdSink *self = (GstUnixFdSink *) bsink;
+  GST_OBJECT_LOCK (self);
+  gboolean absent = !self->wait_for_connection && g_hash_table_size (self->clients) == 0;
+  GST_OBJECT_UNLOCK (self);
+  if (absent)
+    return GST_FLOW_OK;
+  gboolean fd_only = TRUE;
+  for (guint i = 0; i < gst_buffer_n_memory (buffer); i++)
+    fd_only &= gst_is_fd_memory (gst_buffer_peek_memory (buffer, i));
+  if (fd_only)
+    return gst_unix_fd_sink_render_fd (bsink, buffer);
+  GstAllocator *allocator = gst_shm_allocator_get ();
+  GstBuffer *copy = gst_buffer_new_allocate (allocator, gst_buffer_get_size (buffer), NULL);
+  gst_object_unref (allocator);
+  if (copy == NULL)
+    return GST_FLOW_ERROR;
+  GstMapInfo map = GST_MAP_INFO_INIT;
+  if (!gst_buffer_map (copy, &map, GST_MAP_WRITE)) {
+    gst_buffer_unref (copy);
+    return GST_FLOW_ERROR;
+  }
+  gboolean complete = gst_buffer_extract (buffer, 0, map.data, map.size) == map.size;
+  gst_buffer_unmap (copy, &map);
+  gst_buffer_copy_into (copy, buffer, GST_BUFFER_COPY_METADATA, 0, -1);
+  GstFlowReturn ret = complete ? gst_unix_fd_sink_render_fd (bsink, copy) : GST_FLOW_ERROR;
+  gst_buffer_unref (copy);
+  return ret;
+}
